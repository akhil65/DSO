# ─── Exercise 4.6.3 — Contrast RASP v3 ──────────────────────────────────────
# @contrast/rasp-v3 is the open-source RASP core from Contrast Security (pre-release).
#
# FIX (Node.js v22+): @contrast/rasp-v3 is an ESM module with top-level await.
# require() cannot load it. Switched from --require to --import with .mjs loader.
#
# Build: docker compose --profile contrast-rasp build
# Run:   docker compose --profile contrast-rasp up -d
# Logs:  docker compose logs -f juice-shop-contrast-rasp

# ─── Stage 1: install @contrast/rasp-v3 (needs npm + build tools) ─────────────
FROM node:20-alpine AS builder
WORKDIR /build

RUN npm install @contrast/rasp-v3@0.7.0-alpha.5 --save --ignore-scripts 2>&1 | tail -5

# Copy the ESM loader (replaces the old CJS wrapper)
COPY contrast-rasp-loader.mjs /build/contrast-rasp-loader.mjs

# ─── Stage 2: inject into distroless Juice Shop ───────────────────────────────
FROM bkimminich/juice-shop:latest

COPY --from=builder --chmod=755 /build/node_modules/@contrast /juice-shop/contrast_modules/@contrast
COPY --from=builder --chmod=644 /build/contrast-rasp-loader.mjs /juice-shop/contrast-rasp-loader.mjs

# NODE_PATH: rasp-v3's initialize.js requires '@contrast/require-hook' by bare name.
# That package is at /juice-shop/contrast_modules/@contrast/require-hook, but Node.js
# won't find it unless we tell it to look in /juice-shop/contrast_modules/.
ENV NODE_PATH="/juice-shop/contrast_modules"

# --import (not --require) loads an ES module before the app starts.
# Node.js waits for all top-level awaits to finish before starting Juice Shop.
# file:// prefix is required for absolute paths with --import.
ENV NODE_OPTIONS="--import file:///juice-shop/contrast-rasp-loader.mjs"

EXPOSE 3000
